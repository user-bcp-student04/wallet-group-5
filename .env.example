# Copia este archivo a `.env` (no se versiona). Docker Compose lo lee solo y
# `python tools/lab.py start api` también. Ninguno de estos valores es un secreto real.

# Simulador de wallet del grupo 5 (estado compartido por todo el grupo).
WALLET_MOCK_URL=https://bcp-wallet-mock.yefri.workers.dev/groups/5

# Doble factor simulado: código de prueba de 6 dígitos. Sin él, el doble factor queda
# no disponible y no se puede activar ninguna wallet. Nunca se devuelve ni se registra.
ONBOARDING_OTP_TEST_CODE=123456

# Opcional: clave Fernet para cifrar el documento en reposo
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Si se omite, la API crea una clave local en la carpeta de datos.
ONBOARDING_DATA_KEY=

# Opcional: texto mostrado cuando el registro no puede continuar (cuenta existente u otra causa).
ONBOARDING_SUPPORT_MESSAGE=
